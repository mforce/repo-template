#!/bin/sh
# commit-msg: keep a commit parseable by release-please.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Skip once:               git commit --no-verify   (or SKIP_HOOKS=1)
#
# WHY THIS EXISTS. release-please runs @conventional-commits/parser over the
# WHOLE message, subject and body. A parse error is caught, logged as "commit
# could not be parsed", and the commit is then dropped entirely — no changelog
# entry, no bump contribution — while the workflow still reports success. That
# failure is silent in both directions: nothing goes red, and the missing entry
# is only noticed when someone reads the release notes.
#
# SCOPE OF THE CLAIM — read this before trusting it. This is NOT a conventional-
# commits parser and does not try to be one. It matches two shapes observed to
# break release-please, verified against the real parser. A message it passes can
# still be unparseable in some way nobody has hit yet.
#
# THE GAP IT CANNOT CLOSE: the SUBJECT of a multi-commit squash. With
# squash_merge_commit_title=COMMIT_OR_PR_TITLE, a one-commit PR's subject is the
# commit subject (covered here) but a multi-commit PR's subject is the PR TITLE,
# which no local hook can see. Reviewers own that half, via the "PR title is the
# release note" rule in CONTRIBUTING.md.
#
# POSIX sh on purpose: git invokes the shebang directly, and sh exists everywhere
# git does (including git-for-windows).
set -eu

[ "${SKIP_HOOKS:-0}" = "1" ] && exit 0

msg=$1
fail=0

# WHAT GIT ACTUALLY STORES. It is tempting to strip comment lines and everything
# below the scissors marker on the assumption that git always removes them. It
# does not, and a hook is never told which cleanup mode is in effect. Measured
# with `git commit -F`:
#
#   cleanup                # lines   scissors line   content BELOW scissors
#   default (whitespace)   kept      kept            KEPT
#   --cleanup=scissors     kept      kept            KEPT
#   --cleanup=strip        removed   removed         KEPT
#
# So an offending line survives in all three while a stripping hook would pass
# it — a false negative, the direction that lets the bug ship. Judge the whole
# message instead.
#
# The one part git always drops is the `git commit -v` diff. Identifying it by a
# bare `diff --git ` line is not good enough: that also discards an AUTHORED
# patch excerpt, which git stores and the parser then chokes on. What
# distinguishes git's own section is its framing — `commit -v` always emits the
# scissors marker, then its notes, then the diff. So the tail is dropped only
# when a `diff --git ` line is PRECEDED by a scissors line with no blank line in
# between.
#
# The marker is matched WITHOUT hardcoding '#': core.commentChar (and
# core.commentString on newer git) changes the prefix, and a literal '#' match
# misses git's own marker when the prefix is something else, so its verbose diff
# gets treated as authored text and an ordinary commit is rejected. Only the
# structural part -- dashes, >8, dashes -- is fixed.
#
# ADJACENCY IS REQUIRED, not "scissors ever seen, then some later diff --git":
# the looser form lets a scissors line followed eventually by any line starting
# with "diff --git " — even an unrelated prose mention — truncate everything from
# there on, so a genuine offending line after that mention is never read.
#
#   scissors, then diff --git, no blank line   -> exempted (git's own shape)
#   scissors ... blank line ... diff --git     -> CHECKED
#   diff --git, no scissors                    -> authored excerpt -> CHECKED
#   scissors, no diff --git                    -> authored text    -> CHECKED
#
# WHAT THIS CANNOT CLOSE, from content alone: git strips a `-v` diff
# unconditionally, so the message a real `-v` commit hands this hook is
# byte-identical to one where an author typed the same scissors-plus-diff text on
# purpose. No content-only check tells those apart. Accepted — this is a
# skippable local hook that exists to catch ACCIDENTAL breakage, and defeating it
# that way takes the same intent as `--no-verify`.
body=$(awk '
  scissors_line { if ($0 ~ /^diff --git /) { exit }; if ($0 !~ /^[^[:space:]]/) { scissors_line = 0 }; print; next }
  /^[^[:space:]]+[[:space:]]+-+[[:space:]]+>8[[:space:]]+-+[[:space:]]*$/ { scissors_line = 1; print; next }
  { print }
' "$msg")

# The subject is the first non-blank line of the message AS WRITTEN, comment or
# not. Skipping comment lines here repeats the same mistake one line lower: under
# `whitespace` cleanup a leading comment IS the stored subject, so an untouched
# editor template would sail through and land a commit whose subject is
# "# Please enter the commit message...". Judging the raw line rejects that.
subject=$(printf '%s\n' "$body" | awk 'NF { print; exit }')

# --- 1. Subject must be a conventional header. -------------------------------
# The type list is deliberately open (any lowercase word): release-please's
# config decides which types are changelog-visible, and an unknown type still
# parses and still bumps the patch digit. What does NOT parse is a missing or
# malformed "type: " prefix — e.g. "Credential epoch: ..." has a space before the
# colon, so "Credential" is not a type.
# A revert or fixup is git's own shape; leave it alone.
case $subject in
  'Revert "'*|fixup!*|squash!*|amend!*) ;;
  *)
    if ! printf '%s\n' "$subject" | grep -qE '^[a-z][a-z0-9]*(\([^()]+\))?!?: .'; then
      echo "commit-msg: subject is not a conventional header." >&2
      echo "  got:    $subject" >&2
      echo "  want:   type(scope): summary     e.g. fix(auth): reject an expired refresh token" >&2
      echo "  note:   no space before the colon; scope may not contain parens." >&2
      fail=1
    fi
    ;;
esac

# --- 2. No body line that lexes as a nested type(scope) header. --------------
# Trigger: a line starting at column 1 with non-whitespace, non-paren characters,
# then '(', then another '(' before the closing ')'. Ordinary code prose:
#   Assert.Single(AllMigrations())   <- breaks
#   f(g(h))  a(())  a.b(c(d))        <- breaks
# Defused by any of: leading whitespace (space OR TAB — the class must exclude
# all whitespace, not just the literal space, or tab-indented prose is rejected
# while the real parser accepts it), a list marker, or a preceding word —
#       Assert.Single(AllMigrations())
#   - Assert.Single(AllMigrations())
#   see Assert.Single(AllMigrations())
# and these were never a problem: foo(bar)  x() y()  (a(b))
offenders=$(printf '%s\n' "$body" | grep -nE '^[^[:space:]()]+\([^)]*\(' || true)
if [ -n "$offenders" ]; then
  echo "commit-msg: release-please cannot parse this message, so the WHOLE commit" >&2
  echo "            would be dropped from the changelog — silently, on a green run." >&2
  # Show the fix applied to the author's OWN line. Generic advice reads as
  # boilerplate; the same sentence with their text in it gets acted on.
  printf '%s\n' "$offenders" | while IFS= read -r offender; do
    n=${offender%%:*}
    text=${offender#*:}
    echo >&2
    printf '  line %s\n' "$n" >&2
    printf '     got:  %s\n' "$text" >&2
    printf '     any of these is fine instead:\n' >&2
    printf '           %s        (indent it)\n' "$text" >&2
    printf '         - %s        (make it a list item)\n' "$text" >&2
    printf '         see %s      (put a word in front)\n' "$text" >&2
  done
  fail=1
fi

[ "$fail" -eq 0 ] || {
  echo "commit-msg: FAILED — fix, or use --no-verify to override." >&2
  exit 1
}

exit 0
